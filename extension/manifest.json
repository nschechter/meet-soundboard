{
  "manifest_version": 3,
  "name": "Meet Soundboard",
  "version": "1.5.15",
  "description": "A soundboard inside Google Meet. Play classic reaction sounds or your own clips into your meeting audio.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Meet Soundboard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "sounds.js",
        "audio.js",
        "engine.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "sounds.js",
        "panel-style.js",
        "clip-editor.js",
        "panel.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
