{
  "manifest_version": 3,
  "name": "Meeting Soundboard Beta",
  "version": "1.6.1",
  "description": "A soundboard for Google Meet, with experimental Teams and Zoom browser support. Play reactions or your own clips.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Meeting Soundboard Beta",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*",
        "https://app.zoom.us/wc",
        "https://app.zoom.us/wc/*",
        "https://app.zoom.com/wc",
        "https://app.zoom.com/wc/*",
        "https://zoom.us/wc",
        "https://zoom.us/wc/*",
        "https://zoom.com/wc",
        "https://zoom.com/wc/*"
      ],
      "js": [
        "platforms.js",
        "sounds.js",
        "audio.js",
        "engine.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*",
        "https://app.zoom.us/wc",
        "https://app.zoom.us/wc/*",
        "https://app.zoom.com/wc",
        "https://app.zoom.com/wc/*",
        "https://zoom.us/wc",
        "https://zoom.us/wc/*",
        "https://zoom.com/wc",
        "https://zoom.com/wc/*"
      ],
      "js": [
        "platforms.js",
        "library.js",
        "sounds.js",
        "panel-style.js",
        "clip-editor.js",
        "panel.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "version_name": "1.6.1 experimental",
  "background": {
    "service_worker": "background.js"
  }
}
