{
  "manifest_version": 3,
  "name": "Meeting Soundboard",
  "version": "1.6.2",
  "description": "A soundboard for Google Meet and Microsoft Teams in Chrome. Play classic reactions or your own clips into meeting audio.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Meeting Soundboard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "platforms.js",
        "sounds.js",
        "audio.js",
        "engine.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "platforms.js",
        "library.js",
        "sounds.js",
        "panel-style.js",
        "clip-editor.js",
        "panel.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
